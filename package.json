{
  "name": "romanized-to-unicode-and-ascii",
  "version": "0.1.0",
  "description": "Transliterate romanized/phonetic text into real Devanagari Unicode (Nepali), plus convert to legacy ASCII-glyph fonts (Preeti, Kantipur, Himali).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Rishikesh Sherchan",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
